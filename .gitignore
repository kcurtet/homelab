# Secrets — real values live here, never committed; only .env.example is tracked
.env

# Runtime data volumes (Coolify state, AdGuard Home config, etc.)
**/data/

# restic local cache
**/.restic-cache/

# Dashboard build artifacts
dashboard/node_modules/
dashboard/dist/
dashboard/.astro/

# tasteskill working files (direction sheets, inspect screenshots)
.taste-skill/

# Traefik ACME account key + certs (private material)
**/traefik/letsencrypt/
