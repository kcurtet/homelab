# restic backup configuration.
#
# Two copies of this file exist in operation, both gitignored/private:
#   - backup/.env            for manual runs from a repo checkout
#   - /etc/homelab/backup.env for the systemd units (mode 600, root-owned).
#     NOTE: systemd does NOT read backup/.env — the runbook (backup/README.md)
#     copies this example to /etc/homelab/backup.env. Values already present
#     in the environment (systemd EnvironmentFile, exports) win over the file.
#
# This repo is public: never put real secrets here.

# Destination repository.
# Production (Raspberry era): the USB disk mounted at /mnt/backup — see
# backup/README.md for the fstab-by-UUID setup.
# Staging (panther or any test box) may point this at a plain local directory
# instead, e.g. /var/backups/homelab.restic — restic treats both identically
# once initialized; only the location differs.
RESTIC_REPOSITORY=/mnt/backup/homelab.restic

# Repository encryption key, kept OUTSIDE the repo (the repo is public).
# Generate on the backup host as root:
#   install -d -m 700 /etc/homelab
#   umask 077 && head -c 32 /dev/urandom | base64 > /etc/homelab/restic.pass
# Must be chmod 600 — the scripts refuse anything looser.
# WARNING: losing this file means losing every backup. Store a copy offline.
RESTIC_PASSWORD_FILE=/etc/homelab/restic.pass

# What to snapshot — the fixed lab scope (spec: lab state + /home, NO rootfs).
# Space-separated list. Entries relative to the repo checkout are resolved
# against the repo root by the scripts; absolute paths are used as-is.
#   /home                     Dokku state (app configs, git repos) + Kuma via monitoring/data
#   monitoring/data           Uptime Kuma state (monitors, history)
#   network/adguardhome/data  AdGuard Home config + state (empty until the Raspberry era)
#   .                         this repo itself (infrastructure as code)
#   /home                     home dirs of the host that runs the timer
BACKUP_PATHS=monitoring/data network/adguardhome/data . /home
