# Pi-hole v6 environment — copy to `.env` and adjust:
#   cp .env.example .env
# `.env` is gitignored; only this example file is committed.
#
# All FTLCONF_* keys below are Pi-hole v6 syntax. Sources:
#   - https://docs.pi-hole.net/ftldns/configfile/  (full [dhcp]/[dns]/[misc] reference)
#   - https://docs.pi-hole.net/docker/upgrading/v5-v6/ (v5 DHCP_* -> v6 FTLCONF_dhcp_* table)
#
# NOTE: FTL matches FTLCONF_ variable names case-insensitively, but we use the
# official camelCase spelling from the docs (e.g. FTLCONF_dns_listeningMode).

###############################################################################
# SAFE DEFAULT: DHCP OFF
###############################################################################
# Pi-hole's DHCP server is DISABLED by default. The house router stays the only
# DHCP server until the migration runbook (docs/runbooks/dhcp-migration.md) is
# followed by hand — Raspberry era only, never on staging (family helpdesk rule).
# flip to `true` ONLY as part of that runbook.
PIHOLE_DHCP_ACTIVE=false

###############################################################################
# DHCP pool (only used when PIHOLE_DHCP_ACTIVE=true)
###############################################################################
# First/last address of the pool Pi-hole will hand out. Keep the range inside
# the LAN subnet (192.168.1.0/24 here) and OUTSIDE any static/reservation range
# configured on the router. The router (192.168.1.1) and the server itself must
# never fall inside the pool.
PIHOLE_DHCP_START=192.168.1.201
PIHOLE_DHCP_END=192.168.1.250
# Gateway advertised to clients -> FTLCONF_dhcp_router. In a home network this
# is the router, same address as the DNS failover target below.
PIHOLE_DHCP_ROUTER=192.168.1.1
# Also answer DHCPv6/SLAAC requests (FTLCONF_dhcp_ipv6). Off by default: IPv6
# prefix delegation is ISP-dependent; enable only after the IPv4 migration has
# been verified (see runbook).
PIHOLE_DHCP_IPV6=false

###############################################################################
# DNS FAILOVER — THE KEY DESIGN OF THIS LAB (spec: "Improvements over the article" #1)
###############################################################################
# Secondary DNS advertised by Pi-hole's DHCP: the router. 192.168.1.1 is the
# typical home-router address (documentation default, not a secret) — adjust to
# your LAN. Wired into the compose as a dnsmasq line:
#   FTLCONF_misc_dnsmasq_lines: dhcp-option=option:dns-server,0.0.0.0,<this>
# which makes leases say: DNS1 = the Pi-hole host (dnsmasq special value 0.0.0.0
# = "address of the machine running dnsmasq"), DNS2 = the router. Pi-hole v6 has
# NO first-class dhcp.dns setting (verified against the [dhcp] reference), so the
# dnsmasq option line is the official escape hatch (FTLCONF_misc_dnsmasq_lines).
# Failover: Pi-hole dies -> clients fall back to the router alone -> the house
# keeps internet, ads return until fixed. Trade-off (accepted by design): some
# clients query DNS2 even in normal operation and leak ads. See the runbook.
PIHOLE_DNS2_ROUTER=192.168.1.1

###############################################################################
# DNS service
###############################################################################
# Who may query Pi-hole -> FTLCONF_dns_listeningMode.
# Allowed: local | single | bind | all | none  (https://docs.pi-hole.net/ftldns/configfile/#listeningmode)
# - `local`: answer queries from hosts on directly connected subnets. With
#   network_mode: host the container shares the host's LAN interface, so this
#   covers the whole 192.168.1.0/24 — the safe default for this deployment.
# - `all`:   answer from anywhere (needed for docker *bridge* networking, open
#            resolver if the host is ever exposed — avoid here).
FTLCONF_dns_listeningMode=local

###############################################################################
# Web UI
###############################################################################
# Admin password (FTLCONF_webserver_api_password). CHANGE IT — placeholder only.
# Real value lives only in .env (gitignored); never commit a real password.
PIHOLE_WEBPASSWORD=change-me-before-first-up

###############################################################################
# Locale
###############################################################################
TZ=Europe/Madrid
