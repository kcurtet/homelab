# AdGuard Home environment — copy to `.env` and adjust:
#   cp .env.example .env
# `.env` is gitignored; only this example file is committed.
#
# These variables feed network/adguardhome/generate-config.sh (which renders
# data/conf/AdGuardHome.yaml on first boot) and docker-compose.yml. Sources:
#   - https://github.com/AdguardTeam/AdGuardHome/wiki/Configuration
#   - https://github.com/AdguardTeam/AdGuardHome/wiki/DHCP
#     (up-to-date mirror: https://adguard-dns.io/kb/adguard-home/dhcp/)

###############################################################################
# Web UI / API auth
###############################################################################
# AdGuard Home's web UI and API are password-protected by a bcrypt hash in
# the seeded YAML — never the plaintext, and the hash itself lives only in
# .env (gitignored), never in a commit.
#
# Generate the hash with htpasswd (official method — wiki Configuration,
# "Reset web password"; $2a$/$2b$/$2y$ markers all accepted, verified against
# v0.107.80):
#   docker run --rm httpd:2-alpine htpasswd -B -C 10 -n admin 'your-password' | cut -d: -f2
# or, with python3-bcrypt at hand:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(10)).decode())"
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD_HASH=CHANGE_ME_bcrypt_hash

# Web UI / API listen address (host networking: this binds on the host's
# stack). 3000 is AdGuard Home's default web port.
ADGUARD_WEB_ADDR=0.0.0.0:3000

###############################################################################
# LAN addressing
###############################################################################
# The DNS failover design needs the LITERAL LAN IP of this host: option 6
# takes literal IPv4 addresses only (no self-referencing "this machine"
# placeholder exists), so the IP must be baked into the seeded YAML.
# 192.168.1.10 is a documentation placeholder — set the real static IP of
# the AdGuard Home host (DHCP reservation or static config). This address is
# DNS1 in every lease; if it changes, the whole house silently loses its
# primary DNS.
ADGUARD_HOST_IP=192.168.1.10
# Secondary DNS advertised in every lease: the house router — the failover
# target. Typical home-router documentation default; adjust to your LAN.
ADGUARD_DNS2_ROUTER=192.168.1.1
# LAN interface the DHCP server binds to when enabled (eth0 on the Raspberry
# Pi; check `ip -o link` on the real host). Only used when DHCP is enabled.
ADGUARD_INTERFACE=eth0

###############################################################################
# SAFE DEFAULT: DHCP OFF
###############################################################################
# The house rule: AdGuard Home's DHCP server is DISABLED by default. The
# router stays the only DHCP server until the migration runbook
# (docs/runbooks/dhcp-migration.md) is followed by hand — Raspberry era
# only, never on staging (family helpdesk rule). generate-config.sh refuses
# to seed with DHCP enabled unless --force is passed.
ADGUARD_DHCP_ENABLED=false

###############################################################################
# DHCP pool (only used when ADGUARD_DHCP_ENABLED=true)
###############################################################################
# First/last address of the pool AdGuard Home will hand out. Keep the range
# inside the LAN subnet (192.168.1.0/24 here) and OUTSIDE any
# static/reservation range configured on the router. The router
# (192.168.1.1) and the server itself must never fall inside the pool.
ADGUARD_DHCP_START=192.168.1.201
ADGUARD_DHCP_END=192.168.1.250
# Gateway advertised to clients (dhcpv4.gateway_ip). In a home network this
# is the router — same address as the DNS failover target above.
ADGUARD_DHCP_GATEWAY=192.168.1.1
ADGUARD_DHCP_NETMASK=255.255.255.0
# Lease duration in seconds (86400 = 24 h, AdGuard Home's own default).
ADGUARD_DHCP_LEASE_DURATION=86400

###############################################################################
# Locale
###############################################################################
TZ=Europe/Madrid
