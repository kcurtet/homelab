# Wake-on-LAN target — copy this file to remote-access/.env (gitignored)
# and fill in real values. This repo is public: never commit a real MAC.
# Documentation placeholders below (AA:BB:CC:DD:EE:FF is not a real device).

# MAC address of the machine to wake (XX:XX:XX:XX:XX:XX)
WOL_MAC=AA:BB:CC:DD:EE:FF

# Destination address for the magic packet. The LAN broadcast address is the
# usual choice (same L2 segment as the target); 255.255.255.255 also works.
WOL_BROADCAST=192.168.1.255
