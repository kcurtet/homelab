# Wake-on-LAN target — copy this file to remote-access/.env (gitignored)
# and fill in real values. This repo is public: never commit a real MAC.
# Documentation placeholders below (AA:BB:CC:DD:EE:FF is not a real device).

# MAC address of the machine to wake (XX:XX:XX:XX:XX:XX)
WOL_MAC=AA:BB:CC:DD:EE:FF

# Destination address for the magic packet.
# NOTE: this script sends via bash /dev/udp, which CANNOT set SO_BROADCAST —
# broadcast destinations (192.168.1.255 / 255.255.255.255) fail with EACCES.
# Use the target machine's unicast IP instead (see wol.md, "The /dev/udp
# broadcast caveat"), or install `wakeonlan` for real broadcast support.
WOL_BROADCAST=192.168.1.50
