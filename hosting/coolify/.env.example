# Coolify environment — copy to .env and fill every empty value.
# Variable names are Coolify's own (the official installer writes this same set);
# the plan's COOLIFY_APP_ID/SECRET_KEY map to APP_ID/APP_KEY/DB_PASSWORD/REDIS_PASSWORD below.
# .env is gitignored — never commit real values.

# --- Application ---
APP_ID=
APP_NAME=Coolify
# Laravel APP_KEY: base64:$(openssl rand -base64 32)
APP_KEY=

# --- Database (postgres) ---
DB_USERNAME=coolify
DB_DATABASE=coolify
# $(openssl rand -base64 32)
DB_PASSWORD=

# --- Redis ---
# $(openssl rand -base64 32)
REDIS_PASSWORD=

# --- Realtime (pusher/reverb, internal to the coolify container) ---
# all three: $(openssl rand -hex 32)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_BACKEND_PORT=6001

# --- Ports (host side) ---
# Coolify UI + API: http://<host>:${APP_PORT}
APP_PORT=8000
REVERB_PORT=6001

# --- First-run root account (OPTIONAL) ---
# Leave empty to create the root account in the web wizard within 10 minutes of
# the first start (a common official-installer footgun). Uncomment to preseed
# for unattended installs.
# ROOT_USERNAME=
# ROOT_USER_EMAIL=
# ROOT_USER_PASSWORD=
