# Homelab dashboard configuration — placeholders only, real values live in .env

# Host port the dashboard is published on (loopback only; tailscale serve fronts it)
DASHBOARD_PORT=4321

# Pi-hole stats via its API (optional; without a token the card shows
# container health only)
PIHOLE_URL=
PIHOLE_API_TOKEN=

# Hub links (optional)
HUB_COOLIFY_URL=
HUB_PIHOLE_URL=
HUB_TAILSCALE_URL=
