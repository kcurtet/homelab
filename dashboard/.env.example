# Homelab dashboard configuration — placeholders only, real values live in .env

# Host port the dashboard is published on (loopback only; tailscale serve fronts it)
DASHBOARD_PORT=4321

# Compose projects (phases) that get a card even when not deployed
EXPECTED_PROJECTS=hosting,network,dashboard

# Docker API endpoint; unset falls back to the local rootless podman socket
# (dev). In the container the compose file sets tcp://socket-proxy:2375.
DOCKER_HOST=

# AdGuard Home stats via its API (optional; without credentials the card
# shows container health only). Reserved placeholder — no consumer in the
# dashboard code yet (deferred minor, see spec 002 progress ledger).
ADGUARD_URL=
ADGUARD_API_TOKEN=

# Hub links (optional)
HUB_DOKKU_URL=
HUB_ADGUARD_URL=
HUB_TAILSCALE_URL=

# Manual backup (task 6). PRODUCTION BINDS ARE FIXED — the host is expected
# to have the homelab checkout at /repo, plus /etc/homelab (backup.env,
# restic.pass) and /mnt/backup (restic repository). The overrides below are
# for staging boxes and local dry-runs ONLY; leave them unset in production.
# The image is built on the host: podman build -f backup.Dockerfile -t
# homelab-backup dashboard/
BACKUP_IMAGE=
BACKUP_BIND_REPO=
BACKUP_BIND_ETC=
BACKUP_BIND_MNT=
BACKUP_BIND_HOME=
BACKUP_CACHE_DIR=
