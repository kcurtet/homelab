---
// Single page: header (question + finding) → phase grid (polling island) →
// backup placeholder → hub → footer (freshness). The screen's one question is
// "is the lab up?": the h1 row leads, the finding line names the worst phase,
// and the grid is the biggest block on the page.
import Base from '../layouts/Base.astro';
import StatusGrid from '../components/StatusGrid.astro';
import HubLinks from '../components/HubLinks.astro';
---

<Base>
  <header class="topbar">
    <a class="brand" href="/">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <rect x="2" y="3" width="16" height="3.5" rx="1.2" fill="var(--accent)"></rect>
        <rect x="2" y="8.25" width="16" height="3.5" rx="1.2" fill="var(--accent)" opacity="0.55"></rect>
        <rect x="2" y="13.5" width="16" height="3.5" rx="1.2" fill="var(--accent)" opacity="0.3"></rect>
      </svg>
      homelab
    </a>
    <span class="conn" id="conn" data-conn="connecting" role="status" aria-live="polite">
      <span class="conn__dot" aria-hidden="true"></span>
      <span class="conn__label">connecting</span>
    </span>
  </header>

  <main class="wrap">
    <div class="page-head">
      <div class="page-head__titles">
        <h1>homelab</h1>
        <p class="page-head__sub">via Docker API · tailscale-only</p>
      </div>
      <p class="finding" id="finding" aria-live="polite" data-ok="false">
        checking phases…
      </p>
    </div>

    <StatusGrid />

    <section class="sec" aria-labelledby="backup-h">
      <div class="duo">
        <div>
          <h2 id="backup-h" class="sec-title">backup</h2>
          <ul class="kv">
            <li>
              <span class="kv__label">last snapshot</span>
              <span class="kv__value">
                <span class="kv__dash" aria-hidden="true">—</span>coming with the
                manual-trigger task
              </span>
            </li>
          </ul>
        </div>
        <HubLinks />
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <p class="foot__row">
        <span class="foot__fetched" id="fetched">not fetched yet</span>
        <span>polling every 10s</span>
      </p>
    </div>
  </footer>
</Base>
