# Media phase environment — cp .env.example .env and fill.
# .env is gitignored; only this example is committed.

# --- Proton VPN (dashboard → Account → OpenVPN / IKEv2 credentials) ---
PROTON_USER=
PROTON_PASS=
# Exit country for the tunnel (Proton free: Netherlands / US / Japan)
VPN_COUNTRY=Netherlands

# --- qBittorrent (for the port forwarder) ---
# Leave empty on first boot: read the TEMPORARY password from
#   docker logs qbittorrent | grep -i password
# log in at http://<host>:8080, set a permanent password, put it here,
# then `docker compose up -d qbittorrent-port-forwarder`.
QBT_USERNAME=admin
QBT_PASSWORD=

# --- *arr API keys (Settings → General → API Key in each app) ---
# Fill after first login so unpackerr can watch completed downloads.
SONARR_API_KEY=
RADARR_API_KEY=
